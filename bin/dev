#!/usr/bin/env bash
#
# Local WordPress test environment for the Trending Now plugin.
#
#   bin/dev up        start containers and install both sites
#   bin/dev seed      create sample posts on the source site
#   bin/dev configure register the source and GDELT sources on the site under test
#   bin/dev ingest    run a full ingest cycle synchronously
#   bin/dev status    plugin diagnostics as JSON
#   bin/dev verify    assert the rendered widget contains real links
#   bin/dev wp ...    run wp-cli against the site under test
#   bin/dev src ...   run wp-cli against the source site
#   bin/dev logs      tail PHP/WordPress logs
#   bin/dev shell     shell into the site under test
#   bin/dev reset     destroy everything, including volumes
#
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

MAIN_URL="http://localhost:8080"
SOURCE_URL="http://127.0.0.1:8081"
ADMIN_USER="admin"
ADMIN_PASS="admin"
ADMIN_EMAIL="dev@example.test"

dc() { docker compose "$@"; }
wp() { docker compose run --rm -T cli "$@"; }
src() { docker compose run --rm -T cli_source "$@"; }

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }

wait_for_http() {
	local url="$1" tries="${2:-60}"
	for _ in $(seq 1 "$tries"); do
		if curl -fsS -o /dev/null "$url" 2>/dev/null; then return 0; fi
		sleep 2
	done
	return 1
}

cmd_up() {
	log "Starting containers"
	dc up -d db wordpress source

	log "Waiting for $MAIN_URL"
	wait_for_http "$MAIN_URL" || { warn "site under test did not respond"; exit 1; }
	log "Waiting for $SOURCE_URL"
	wait_for_http "$SOURCE_URL" || { warn "source site did not respond"; exit 1; }

	install_site wp "$MAIN_URL" "Trending Now Test"
	install_site src "$SOURCE_URL" "Example Sports"

	log "Configuring the site under test"
	wp rewrite structure '/%postname%/' --hard >/dev/null
	wp plugin activate trending-now
	wp rewrite flush --hard >/dev/null

	log "Configuring the source site"
	src rewrite structure '/%postname%/' --hard >/dev/null
	src rewrite flush --hard >/dev/null

	echo
	log "Site under test : $MAIN_URL/wp-admin  ($ADMIN_USER / $ADMIN_PASS)"
	log "Source site     : $SOURCE_URL/wp-admin  ($ADMIN_USER / $ADMIN_PASS)"
}

install_site() {
	local runner="$1" url="$2" title="$3"

	if "$runner" core is-installed >/dev/null 2>&1; then
		log "$title already installed"
		return
	fi

	log "Installing $title at $url"
	"$runner" core install \
		--url="$url" \
		--title="$title" \
		--admin_user="$ADMIN_USER" \
		--admin_password="$ADMIN_PASS" \
		--admin_email="$ADMIN_EMAIL" \
		--skip-email
}

cmd_seed() {
	log "Seeding posts on the source site"

	# One eval, because each `docker compose run` gets a fresh container and a
	# file written to /tmp in one invocation is gone by the next.
	src eval '
		require_once ABSPATH . "wp-admin/includes/file.php";
		require_once ABSPATH . "wp-admin/includes/image.php";
		require_once ABSPATH . "wp-admin/includes/media.php";

		// 1200x630 so the medium and medium_large intermediate sizes are
		// actually generated, which is what the REST mapping prefers.
		$path = "/tmp/advtn-seed.png";
		$img  = imagecreatetruecolor( 1200, 630 );
		imagefill( $img, 0, 0, imagecolorallocate( $img, 30, 90, 160 ) );
		imagepng( $img, $path );
		imagedestroy( $img );

		$attachment = media_handle_sideload(
			array( "name" => "advtn-seed.png", "tmp_name" => $path ),
			0,
			"Seed image"
		);

		if ( is_wp_error( $attachment ) ) {
			WP_CLI::error( "sideload failed: " . $attachment->get_error_message() );
		}

		for ( $i = 1; $i <= 4; $i++ ) {
			$post_id = wp_insert_post( array(
				"post_type"    => "post",
				"post_status"  => "publish",
				"post_title"   => "Sample network article {$i}",
				"post_excerpt" => "Excerpt for sample network article {$i}.",
				"post_content" => "Body copy for sample network article {$i}.",
			), true );

			if ( is_wp_error( $post_id ) ) {
				WP_CLI::error( $post_id->get_error_message() );
			}

			set_post_thumbnail( $post_id, $attachment );
		}

		// One without a featured image: _embedded is absent entirely for
		// these, which is the case that needs guarding.
		wp_insert_post( array(
			"post_type"    => "post",
			"post_status"  => "publish",
			"post_title"   => "Sample article with no featured image",
			"post_content" => "No thumbnail on this one.",
		), true );

		WP_CLI::success( "attachment {$attachment}, 5 posts published" );
	'

	log "Source site now has $(src post list --post_type=post --post_status=publish --format=count 2>/dev/null | tr -d '\r') published posts"
}

cmd_configure() {
	log "Registering sources on the site under test"

	# GDELT routinely takes 10s+ to answer, well past the 5s production
	# default. Give the local stack room so the source can be exercised.
	wp eval 'advtn()->settings()->update( array( "http_timeout" => 25 ) ); echo "http_timeout: " . advtn()->settings()->get_int( "http_timeout", 1, 30 ) . "\n";'

	# http://source is the container hostname; the REST response still returns
	# public 127.0.0.1:8081 links, which is what gets stored.
	wp eval '
		$settings = advtn()->settings();
		$settings->save_sources( array(
			array(
				"id"      => "src_local1",
				"label"   => "Example Sports (local)",
				"type"    => "wp_rest",
				"enabled" => true,
				"url"     => "http://source",
				"limit"   => 10,
			),
			array(
				"id"            => "src_gdelt1",
				"label"         => "Sports news (GDELT)",
				"type"          => "gdelt",
				"enabled"       => true,
				"limit"         => 20,
				"gdelt_query"   => "sourcelang:english (sportsbook OR \"betting odds\")",
				"gdelt_domains" => array( "espn.com", "cbssports.com", "si.com" ),
				"gdelt_timespan"=> "3d",
			),
		) );
		echo "sources: " . count( $settings->sources() ) . "\n";
	'

	log "Placing the shortcode on a static front page"
	wp eval '
		$existing = get_page_by_path( "trending-home" );
		$page_id  = $existing ? $existing->ID : wp_insert_post( array(
			"post_type"    => "page",
			"post_status"  => "publish",
			"post_name"    => "trending-home",
			"post_title"   => "Home",
			"post_content" => "<p>Front page copy.</p>[trending_now]",
		), true );

		update_option( "show_on_front", "page" );
		update_option( "page_on_front", (int) $page_id );

		echo "front page: " . get_permalink( $page_id ) . "\n";
	'
}

cmd_ingest() {
	log "Running a synchronous ingest cycle"
	wp trending-now ingest --force --sync
}

cmd_status() {
	wp trending-now status
}

cmd_verify() {
	log "Rendering the widget"
	wp trending-now render >/dev/null

	local html
	html="$(wp eval 'echo advtn_get_html();')"

	local count
	count="$(printf '%s' "$html" | grep -o 'advtn__link' | wc -l | tr -d ' ')"
	log "Anchors with class advtn__link: $count"

	if [ "$count" -eq 0 ]; then
		warn "No links rendered. Run: bin/dev seed && bin/dev configure && bin/dev ingest"
		return 1
	fi

	log "Checking the archive route"
	curl -fsS -o /dev/null -w '  /trending/ -> HTTP %{http_code}\n' "$MAIN_URL/trending/"
	curl -fsS -o /dev/null -w '  /trending/page/2/ -> HTTP %{http_code}\n' "$MAIN_URL/trending/page/2/" || true
}

cmd_logs() {
	dc logs -f --tail=100 wordpress source
}

cmd_shell() {
	dc exec wordpress bash
}

cmd_reset() {
	log "Destroying containers and volumes"
	dc down -v
}

main() {
	local command="${1:-up}"
	shift || true

	case "$command" in
		up) cmd_up ;;
		seed) cmd_seed ;;
		configure) cmd_configure ;;
		ingest) cmd_ingest ;;
		status) cmd_status ;;
		verify) cmd_verify ;;
		logs) cmd_logs ;;
		shell) cmd_shell ;;
		reset) cmd_reset ;;
		wp) wp "$@" ;;
		src) src "$@" ;;
		*)
			sed -n '3,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
			exit 1
			;;
	esac
}

main "$@"
