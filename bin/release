#!/usr/bin/env bash
#
# Cut a release of the Trending Now plugin.
#
#   bin/release            build the zip and check everything, publish nothing
#   bin/release --publish  the same, then tag and create the GitHub release
#
# Merging to main ships nothing. Sites learn about a new version from
# GitHub's releases/latest, which ADVTN_Updater polls every six hours and
# compares against the installed Version: header — so a release that was
# never cut is a release no site will ever see.
#
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

SLUG="trending-now"
MAIN_BRANCH="main"

# Everything the plugin does not need at runtime. The zip is what ~160 sites
# unpack; the local stack, the plan documents and the test harness are not
# part of that.
EXCLUDE=(.docker .env.example .gitignore CLAUDE.md bin docker-compose.yml docs tests)

log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

# The three places a version number lives, which have already drifted once:
# ADVTN_VERSION sat at 1.1.7 while the header said 1.2.0. They are twenty
# lines apart and nothing but this checks that they agree.
read_versions() {
	HEADER_VERSION=$(sed -n 's/^ \* Version: *\([0-9][^ ]*\).*/\1/p' "$SLUG.php" | head -1)
	CONST_VERSION=$(sed -n "s/^define( 'ADVTN_VERSION', '\([^']*\)'.*/\1/p" "$SLUG.php" | head -1)

	[ -n "$HEADER_VERSION" ] || die "no Version: header in $SLUG.php"
	[ -n "$CONST_VERSION" ] || die "no ADVTN_VERSION constant in $SLUG.php"

	if [ "$HEADER_VERSION" != "$CONST_VERSION" ]; then
		die "version drift: header says $HEADER_VERSION, ADVTN_VERSION says $CONST_VERSION"
	fi

	VERSION="$HEADER_VERSION"
	TAG="v$VERSION"

	grep -q "^## \[$VERSION\]" CHANGELOG.md \
		|| die "CHANGELOG.md has no '## [$VERSION]' entry — write it before releasing"

	# A fourth place, and the easiest to forget because nothing reads it but a
	# human: the README badge. It was a version behind when this check was added.
	local badge
	badge=$(sed -n 's|.*img.shields.io/badge/version-\([0-9][^-]*\)-.*|\1|p' README.md | head -1)

	if [ -n "$badge" ] && [ "$badge" != "$VERSION" ]; then
		die "version drift: README badge says $badge, plugin says $VERSION"
	fi
}

# Notes come from the CHANGELOG section rather than being typed at release
# time, so what the release says and what the repository says cannot diverge.
changelog_notes() {
	awk -v v="## [$VERSION]" '
		index($0, v) == 1 { inside = 1; next }
		inside && /^## \[/ { exit }
		inside { print }
	' CHANGELOG.md
}

preflight() {
	local want="$1"

	command -v composer >/dev/null || die "composer not found"
	command -v zip >/dev/null || die "zip not found"

	if [ -n "$(git status --porcelain)" ]; then
		die "working tree is dirty — commit or stash first"
	fi

	local branch
	branch=$(git rev-parse --abbrev-ref HEAD)

	if [ "$branch" != "$MAIN_BRANCH" ]; then
		if [ "$want" = "yes" ]; then
			die "on '$branch' — release from $MAIN_BRANCH, after the PR is merged"
		fi
		warn "on '$branch', not $MAIN_BRANCH — fine for a dry run, not for --publish"
	fi

	if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
		die "tag $TAG already exists — bump the version first"
	fi

	log "Running the test suite"
	php tests/run.php >/dev/null || die "tests failed — not releasing"

	log "Linting"
	find . -name '*.php' -not -path './vendor/*' -print0 \
		| xargs -0 -n1 php -l >/dev/null || die "lint failed — not releasing"
}

# Built from `git archive`, never from the working directory. Only tracked
# files exist in the export, so an untracked .env, a scratch script or a
# stray dump cannot be published by accident — which matters more here than
# tidiness, because this artifact is public and permanent.
build() {
	local out="$SLUG-$VERSION.zip"

	# Cleaned up on exit rather than on return: a RETURN trap set here fires
	# again when *main* returns, by which point the directory variable is out
	# of scope and `set -u` kills the script after the build already succeeded.
	STAGE=$(mktemp -d)
	trap 'rm -rf "${STAGE:-}"' EXIT

	log "Exporting tracked files at HEAD"
	mkdir -p "$STAGE/$SLUG"
	git archive HEAD | tar -x -C "$STAGE/$SLUG"

	local item
	for item in "${EXCLUDE[@]}"; do
		rm -rf "${STAGE:?}/$SLUG/$item"
	done

	log "Installing runtime dependencies"
	composer install --no-dev --optimize-autoloader --quiet \
		--working-dir="$STAGE/$SLUG" || die "composer install failed"

	rm -f "$out"
	log "Packing $out"
	( cd "$STAGE" && zip -qr "$out" "$SLUG" )
	mv "$STAGE/$out" .

	ZIP="$out"
}

# A release is public and permanent. These are the mistakes worth catching
# before it is, not after: a secret riding along, or an archive that unpacks
# to the wrong directory and installs as a second plugin.
verify_zip() {
	log "Verifying $ZIP"

	local names
	names=$(unzip -Z1 "$ZIP")

	local roots
	roots=$(printf '%s\n' "$names" | cut -d/ -f1 | sort -u)
	[ "$roots" = "$SLUG" ] || die "zip has unexpected top-level entries: $roots"

	printf '%s\n' "$names" | grep -q "^$SLUG/vendor/autoload.php$" \
		|| die "vendor/autoload.php missing — the plugin would fatal on activation"

	printf '%s\n' "$names" | grep -q "^$SLUG/$SLUG.php$" \
		|| die "$SLUG.php missing from the zip"

	local item
	for item in "${EXCLUDE[@]}"; do
		if printf '%s\n' "$names" | grep -q "^$SLUG/$item"; then
			die "$item was excluded but is present in the zip"
		fi
	done

	if printf '%s\n' "$names" | grep -Eq '(^|/)\.(env|git)($|/)'; then
		die "the zip carries a .env or .git entry"
	fi

	local packed
	packed=$(unzip -p "$ZIP" "$SLUG/$SLUG.php" | sed -n 's/^ \* Version: *\([0-9][^ ]*\).*/\1/p' | head -1)
	[ "$packed" = "$VERSION" ] || die "packed plugin reports $packed, expected $VERSION"

	log "$(printf '%s\n' "$names" | grep -c .) entries, $(du -h "$ZIP" | cut -f1)"
}

publish() {
	command -v gh >/dev/null || die "gh not found"

	log "Tagging $TAG"
	git tag -a "$TAG" -m "Trending Now $VERSION"
	git push origin "$TAG"

	log "Creating the GitHub release"
	changelog_notes | gh release create "$TAG" "$ZIP" \
		--title "Trending Now $VERSION" \
		--notes-file -

	log "Published. Sites pick it up within six hours, or immediately via Diagnostics → Check for updates."
}

main() {
	local do_publish=no

	case "${1:-}" in
		--publish) do_publish=yes ;;
		"") ;;
		*) sed -n '3,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
	esac

	read_versions
	log "Trending Now $VERSION ($TAG)"

	preflight "$do_publish"
	build
	verify_zip

	if [ "$do_publish" = "yes" ]; then
		publish
	else
		echo
		log "Built $ZIP. Nothing was tagged or published."
		log "Review it, then run: bin/release --publish"
	fi
}

main "$@"
