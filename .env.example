# Local development credentials. Copy to .env and fill in.
# docker compose reads .env from this directory automatically, and passes these
# through to WordPress as constants — see docker-compose.yml.
#
# .env is gitignored. Never commit real keys.

# SerpAPI key, for "Google News (SerpAPI)" sources.
# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# GitHub personal access token, only needed if the plugin repository is private.
# Fine-grained token with read-only Contents access is enough.
GITHUB_TOKEN=
